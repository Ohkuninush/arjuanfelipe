{
  "wds_version": "1.0.0",
  "consumes": {
    "cds_version": "1.0.0",
    "canonical_glyph": "B-PRIME-COMPENSATED",
    "note": "The WDS consumes the IPS. It never modifies the CDS. Canonical colours below are read, not chosen."
  },

  "canonical_palette": {
    "_role": "Read from the identity. NOT a WDS decision.",
    "background": "#10141a",
    "surface": "#161c24",
    "foreground": "#e7ebee",
    "foreground_secondary": "#a7b0b9",
    "foreground_tertiary": "#8b949c",
    "accent": "#ea6a1e",
    "accent_hover": "#ec8d55"
  },

  "semantic_hue_rotation": {
    "_role": "Degrees of OKLCH hue rotation from the canonical accent. Lightness and chroma are held, so contrast is constant by construction.",
    "primary": 0,
    "warning": 49.3,
    "success": 104.3,
    "info": 194.3,
    "danger": 334.3
  },

  "surface_lightness": {
    "_role": "OKLCH L values for the surface stack. Hue and chroma inherited from the canonical background, so every surface is the same colour at a different depth.",
    "dark": {
      "base": 0.1899,
      "raised": 0.2241,
      "elevated": 0.2650,
      "interactive": 0.3050,
      "border_subtle": 0.2900,
      "border": 0.3600,
      "border_strong": 0.4500
    },
    "light": {
      "base": 0.9850,
      "raised": 0.9620,
      "elevated": 0.9400,
      "interactive": 0.9150,
      "border_subtle": 0.8900,
      "border": 0.8200,
      "border_strong": 0.7200
    }
  },

  "text_lightness": {
    "dark": {"primary": 0.9379, "secondary": 0.7529, "tertiary": 0.6618, "quiet": 0.6200},
    "light": {"primary": 0.2200, "secondary": 0.4000, "tertiary": 0.4900, "quiet": 0.5400}
  },

  "type_scale": {
    "_role": "Modular scale, ratio 1.25 (major third), anchored at 16px body.",
    "ratio": 1.25,
    "base_px": 16,
    "steps": {
      "caption": -1,
      "body": 0,
      "lead": 1,
      "h5": 1,
      "h4": 2,
      "h3": 3,
      "h2": 4,
      "h1": 5,
      "display": 6
    },
    "fluid_viewport_min_px": 360,
    "fluid_viewport_max_px": 1280
  },

  "spacing": {
    "_role": "Base-4 scale. Every gap in the system is one of these; no arbitrary values.",
    "unit_px": 4,
    "steps": [0, 1, 2, 3, 4, 5, 6, 8, 10, 12, 14, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128]
  },

  "radius": {"none": 0, "xs": 2, "sm": 3, "md": 4, "lg": 6, "xl": 10, "pill": 999},
  "border_width": {"hairline": 1, "thin": 1, "medium": 2, "thick": 3},

  "grid": {
    "columns": 12,
    "container_max_px": 1180,
    "reading_max_ch": 68,
    "code_max_ch": 92,
    "gallery_max_px": 1440,
    "hero_max_px": 1180,
    "gutter_step": 5,
    "margin_step": 8
  },

  "breakpoints_px": {
    "xs": 360,
    "sm": 480,
    "md": 720,
    "lg": 1024,
    "xl": 1280,
    "xxl": 1600,
    "ultrawide": 1920
  },

  "motion": {
    "_role": "Motion communicates state change. Nothing animates for decoration.",
    "duration_ms": {"fast": 120, "base": 180, "slow": 260, "deliberate": 400},
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "entrance": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)",
      "spring": "cubic-bezier(0.2, 1.2, 0.3, 1)"
    }
  },

  "elevation": {
    "_role": "Depth comes from surface lightness first and shadow second. On dark UI, shadow alone is nearly invisible.",
    "levels": ["flat", "raised", "overlay", "modal"],
    "z_index": {
      "base": 0, "raised": 10, "sticky": 100, "header": 200,
      "dropdown": 300, "overlay": 400, "modal": 500, "toast": 600, "tooltip": 700
    }
  },

  "opacity": {"disabled": 0.45, "muted": 0.65, "scrim": 0.72, "ghost": 0.08, "hairline": 0.14},
  "blur_px": {"sm": 4, "md": 12, "lg": 24},

  "focus": {
    "ring_width_px": 2,
    "ring_offset_px": 3,
    "min_contrast_vs_adjacent": 3.0
  },

  "touch_target_min_px": 44
}
